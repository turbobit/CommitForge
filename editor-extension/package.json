{
  "name": "commitforge",
  "displayName": "CommitForge",
  "description": "Claude Code용 Atomic Git Assistant를 설치·관리하고 명령을 실행합니다",
  "version": "1.19.0",
  "publisher": "commitforge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "commitforge.refresh",
        "title": "CommitForge: 상태 새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "commitforge.focusView",
        "title": "CommitForge: 뷰 열기"
      },
      {
        "command": "commitforge.run",
        "title": "CommitForge: 명령 실행",
        "icon": "$(play)"
      },
      {
        "command": "commitforge.cleanLock",
        "title": "CommitForge: lock 해제(clean)",
        "icon": "$(unlock)"
      },
      {
        "command": "commitforge.install",
        "title": "CommitForge: 설치",
        "icon": "$(cloud-download)"
      },
      {
        "command": "commitforge.upgrade",
        "title": "CommitForge: 업그레이드",
        "icon": "$(arrow-up)"
      },
      {
        "command": "commitforge.reinstall",
        "title": "CommitForge: 재설치",
        "icon": "$(sync)"
      },
      {
        "command": "commitforge.uninstall",
        "title": "CommitForge: 제거",
        "icon": "$(trash)"
      },
      {
        "command": "commitforge.verify",
        "title": "CommitForge: 설치 검증",
        "icon": "$(check)"
      },
      {
        "command": "commitforge.revealSnapshots",
        "title": "CommitForge: 스냅샷 폴더 열기",
        "icon": "$(folder-opened)"
      },
      {
        "command": "commitforge.send.cr",
        "title": "CommitForge: 리뷰 실행 (/cr)",
        "icon": "$(search)"
      },
      {
        "command": "commitforge.send.cc",
        "title": "CommitForge: 순차 커밋 실행 (/cc)",
        "icon": "$(git-commit)"
      },
      {
        "command": "commitforge.send.ccf",
        "title": "CommitForge: 파일 단위로 빠르게 커밋 (/ccf)"
      },
      {
        "command": "commitforge.send.cf",
        "title": "CommitForge: 전체 변경을 한 번에 커밋 (/cf)"
      },
      {
        "command": "commitforge.send.cca",
        "title": "CommitForge: 리뷰·수정·검증·commit 전체 실행 (/cca)"
      },
      {
        "command": "commitforge.copyValue",
        "title": "CommitForge: 값 복사"
      }
    ],
    "submenus": [
      {
        "id": "commitforge.scmMore",
        "label": "CommitForge"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitforge",
          "title": "CommitForge",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "commitforge": [
        {
          "id": "commitforge.view",
          "name": "상태"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "commitforge.run",
          "when": "view == commitforge.view",
          "group": "navigation"
        },
        {
          "command": "commitforge.refresh",
          "when": "view == commitforge.view",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "commitforge.upgrade",
          "when": "false"
        },
        {
          "command": "commitforge.reinstall",
          "when": "false"
        },
        {
          "command": "commitforge.revealSnapshots",
          "when": "false"
        },
        {
          "command": "commitforge.send.cr",
          "when": "false"
        },
        {
          "command": "commitforge.send.cc",
          "when": "false"
        },
        {
          "command": "commitforge.send.ccf",
          "when": "false"
        },
        {
          "command": "commitforge.send.cf",
          "when": "false"
        },
        {
          "command": "commitforge.send.cca",
          "when": "false"
        },
        {
          "command": "commitforge.copyValue",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "commitforge.send.cr",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "commitforge.send.cc",
          "when": "scmProvider == git",
          "group": "navigation@2"
        },
        {
          "submenu": "commitforge.scmMore",
          "when": "scmProvider == git",
          "group": "1_commitforge"
        }
      ],
      "commitforge.scmMore": [
        {
          "command": "commitforge.send.ccf",
          "when": "scmProvider == git",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.send.cf",
          "when": "scmProvider == git",
          "group": "1_commitforge@2"
        },
        {
          "command": "commitforge.send.cca",
          "when": "scmProvider == git",
          "group": "1_commitforge@3"
        },
        {
          "command": "commitforge.run",
          "when": "scmProvider == git",
          "group": "1_commitforge@4"
        }
      ],
      "view/item/context": [
        {
          "command": "commitforge.install",
          "when": "view == commitforge.view && viewItem == commitforge.node.install",
          "group": "inline@1"
        },
        {
          "command": "commitforge.upgrade",
          "when": "view == commitforge.view && viewItem == commitforge.node.upgrade",
          "group": "inline@1"
        },
        {
          "command": "commitforge.reinstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.reinstall",
          "group": "inline@1"
        },
        {
          "command": "commitforge.verify",
          "when": "view == commitforge.view && viewItem == commitforge.node.installed",
          "group": "inline@1"
        },
        {
          "command": "commitforge.verify",
          "when": "view == commitforge.view && viewItem == commitforge.node.upgrade",
          "group": "inline@2"
        },
        {
          "command": "commitforge.verify",
          "when": "view == commitforge.view && viewItem == commitforge.node.reinstall",
          "group": "inline@2"
        },
        {
          "command": "commitforge.uninstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.installed",
          "group": "inline@2"
        },
        {
          "command": "commitforge.uninstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.upgrade",
          "group": "inline@3"
        },
        {
          "command": "commitforge.uninstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.reinstall",
          "group": "inline@3"
        },
        {
          "command": "commitforge.revealSnapshots",
          "when": "view == commitforge.view && viewItem == commitforge.node.snapshots",
          "group": "inline@1"
        },
        {
          "command": "commitforge.cleanLock",
          "when": "view == commitforge.view && viewItem == commitforge.node.lock",
          "group": "inline@1"
        },
        {
          "command": "commitforge.install",
          "when": "view == commitforge.view && viewItem == commitforge.node.install",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.upgrade",
          "when": "view == commitforge.view && viewItem == commitforge.node.upgrade",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.reinstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.reinstall",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.verify",
          "when": "view == commitforge.view && viewItem == commitforge.node.installed",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.verify",
          "when": "view == commitforge.view && viewItem == commitforge.node.upgrade",
          "group": "1_commitforge@2"
        },
        {
          "command": "commitforge.verify",
          "when": "view == commitforge.view && viewItem == commitforge.node.reinstall",
          "group": "1_commitforge@2"
        },
        {
          "command": "commitforge.uninstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.installed",
          "group": "1_commitforge@2"
        },
        {
          "command": "commitforge.uninstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.upgrade",
          "group": "1_commitforge@3"
        },
        {
          "command": "commitforge.uninstall",
          "when": "view == commitforge.view && viewItem == commitforge.node.reinstall",
          "group": "1_commitforge@3"
        },
        {
          "command": "commitforge.revealSnapshots",
          "when": "view == commitforge.view && viewItem == commitforge.node.snapshots",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.cleanLock",
          "when": "view == commitforge.view && viewItem == commitforge.node.lock",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.copyValue",
          "when": "view == commitforge.view && viewItem == commitforge.node.lockValue",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.revealSnapshots",
          "when": "view == commitforge.view && viewItem == commitforge.node.snapshotItem",
          "group": "1_commitforge@1"
        },
        {
          "command": "commitforge.copyValue",
          "when": "view == commitforge.view && viewItem == commitforge.node.snapshotItem",
          "group": "1_commitforge@2"
        }
      ]
    },
    "configuration": {
      "title": "CommitForge",
      "properties": {
        "commitforge.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 인터프리터 경로. 비우면 python3, python 순으로 찾습니다."
        },
        "commitforge.terminal.name": {
          "type": "string",
          "default": "CommitForge",
          "description": "확장이 만드는 터미널 이름"
        },
        "commitforge.terminal.launchCommand": {
          "type": "string",
          "default": "claude",
          "description": "새 터미널에서 실행할 명령"
        },
        "commitforge.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "상태바 표시 여부"
        },
        "commitforge.confirmBeforeSend": {
          "type": "boolean",
          "default": true,
          "description": "터미널로 보내기 전 명령을 확인합니다"
        }
      }
    }
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "sync-payload": "node scripts/sync-payload.mjs",
    "build": "npm run sync-version && npm run sync-payload && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "pretest": "npm run sync-payload",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --out commitforge.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
